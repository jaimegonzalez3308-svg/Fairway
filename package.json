{
  "name": "fairway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:browser-test": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:4101 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-test-publishable-key next dev --webpack --hostname 127.0.0.1 --port 3100",
    "test:browser-api": "node tests/fixtures/browser-api.mjs",
    "build": "next build --webpack",
    "ios:sync": "pnpm build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "pnpm ios:sync && cap run ios",
    "ios:services": "node scripts/configure-ios-services.mjs",
    "agent:claude": "node scripts/claude-bridge.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/screen-reader": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "^2.90.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.0.10",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "^0.5.10",
    "@next/swc-wasm-nodejs": "16.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "jsqr": "1.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
